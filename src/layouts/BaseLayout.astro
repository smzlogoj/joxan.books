---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "joxan.books · Reseñas y Estantería Personal", 
  description = "Cuaderno personal de lecturas, valoraciones y reseñas literarias." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen flex flex-col bg-[#F8F9FA] text-[#0F172A] selection:bg-blue-100 selection:text-blue-900">
  
  <!-- Header -->
  <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 font-bold text-lg tracking-tight text-slate-900 group">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 group-hover:scale-125 transition-transform"></span>
        <span>joxan<span class="text-blue-600">.books</span></span>
      </a>

      <nav class="flex items-center gap-4 sm:gap-6 text-sm font-medium">
        <a href="/" class="text-slate-600 hover:text-blue-600 transition-colors">Estantería</a>
        <a href="/#stats" class="text-slate-600 hover:text-blue-600 transition-colors">Estadísticas</a>
        <a 
          href="/keystatic" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-semibold hover:bg-blue-600 transition-colors shadow-sm"
          title="Abrir panel CMS de Keystatic"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          <span>Keystatic CMS</span>
        </a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-white mt-16 py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        <span><strong>joxan.books</strong> · Estilo Minimalista Nórdico</span>
      </div>

      <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200/60 font-medium">
        <span>🤖 Reseñas iniciales generadas por IA a partir de Goodreads</span>
      </div>

      <div>
        <span>Desarrollado con <a href="https://astro.build" target="_blank" class="text-slate-700 hover:underline">Astro</a> y <a href="https://keystatic.com" target="_blank" class="text-slate-700 hover:underline">Keystatic</a></span>
      </div>
    </div>
  </footer>

</body>
</html>
