---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';

const allBooks = await getCollection('books');

// Sort: Currently reading first, then by dateRead descending, then title
const sortedBooks = allBooks.sort((a, b) => {
  if (a.data.status === 'currently-reading' && b.data.status !== 'currently-reading') return -1;
  if (b.data.status === 'currently-reading' && a.data.status !== 'currently-reading') return 1;
  const dateA = a.data.dateRead || '';
  const dateB = b.data.dateRead || '';
  if (dateA && dateB) return dateB.localeCompare(dateA);
  return a.data.title.localeCompare(b.data.title);
});

// Calculations for stats
const totalBooks = allBooks.length;
const readingCount = allBooks.filter(b => b.data.status === 'currently-reading').length;
const readCount = allBooks.filter(b => b.data.status === 'read').length;
const dnfCount = allBooks.filter(b => b.data.status === 'did-not-finish').length;
const topCount = allBooks.filter(b => b.data.rating === 5).length;
const ratedBooks = allBooks.filter(b => b.data.rating > 0);
const avgRating = ratedBooks.length > 0 
  ? (ratedBooks.reduce((acc, b) => acc + b.data.rating, 0) / ratedBooks.length).toFixed(1)
  : '0.0';
const totalPages = allBooks.reduce((acc, b) => acc + (b.data.pages || 0), 0);
---

<BaseLayout title="joxan.books · Estantería y Reseñas Literarias">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-16">
    
    <!-- Hero Section -->
    <section class="mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-slate-200">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
            <span>Biblioteca Personal</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 leading-tight">
            Lecturas & Reseñas
          </h1>
          <p class="text-base text-slate-600 mt-2 max-w-xl">
            Cuaderno digital de libros leídos, valoraciones y fragmentos esenciales importados de Goodreads.
          </p>
        </div>

        <!-- Metrics Grid -->
        <div id="stats" class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-white p-3.5 rounded-xl border border-slate-200/90 shadow-sm text-center">
          <div class="px-3 py-1.5">
            <div class="text-xl font-bold text-slate-900">{totalBooks}</div>
            <div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Títulos</div>
          </div>
          <div class="px-3 py-1.5 border-l border-slate-100">
            <div class="text-xl font-bold text-blue-600">{readingCount}</div>
            <div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Leyendo</div>
          </div>
          <div class="px-3 py-1.5 border-l border-slate-100">
            <div class="text-xl font-bold text-amber-600">{avgRating}★</div>
            <div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Media</div>
          </div>
          <div class="px-3 py-1.5 border-l border-slate-100">
            <div class="text-xl font-bold text-slate-900">{totalPages.toLocaleString('es-ES')}</div>
            <div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Páginas</div>
          </div>
        </div>
      </div>

      <!-- AI Disclosure Box -->
      <div class="mt-6 p-4 rounded-xl bg-amber-50/70 border border-amber-200/80 text-amber-900 flex items-start gap-3 text-xs leading-relaxed">
        <span class="text-lg">🤖</span>
        <div>
          <strong class="font-semibold text-amber-950">Aviso sobre el contenido:</strong> Las reseñas, citas destacadas y análisis literarios de cada uno de los 17 libros han sido <strong>generados inicialmente por Inteligencia Artificial</strong> a partir de los datos registrados en tu cuenta de Goodreads. Puedes modificarlas, ampliarlas o personalizarlas directamente editando los archivos Markdown en <code class="bg-amber-100/80 px-1 py-0.5 rounded text-amber-900 font-mono text-[11px]">src/content/books/</code>.
        </div>
      </div>
    </section>

    <!-- Filter & Search Toolbar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-8">
      
      <!-- Filter Pills -->
      <div class="flex items-center gap-1.5 bg-slate-200/60 p-1 rounded-xl overflow-x-auto" id="filterContainer">
        <button class="filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-white shadow-xs transition-all" data-filter="all">
          Todos ({totalBooks})
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all" data-filter="read">
          Leídos ({readCount})
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all" data-filter="currently-reading">
          Leyendo ({readingCount})
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all" data-filter="top">
          5★ ({topCount})
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all" data-filter="did-not-finish">
          DNF ({dnfCount})
        </button>
      </div>

      <!-- Search Input -->
      <div class="relative min-w-[260px]">
        <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="searchInput"
          placeholder="Buscar por título o autor..." 
          class="w-full pl-9.5 pr-4 py-2 bg-white rounded-xl border border-slate-200 text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 shadow-xs"
        />
      </div>
    </div>

    <!-- Books Grid -->
    <div id="booksGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6">
      {sortedBooks.map((book) => (
        <div class="book-wrapper" data-status={book.data.status} data-rating={book.data.rating} data-title={book.data.title.toLowerCase()} data-author={book.data.author.toLowerCase()}>
          <BookCard id={book.id} book={book.data} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-16 bg-white rounded-xl border border-slate-200 mt-6">
      <div class="text-3xl mb-2">🔍</div>
      <h3 class="text-base font-bold text-slate-800">No se encontraron libros</h3>
      <p class="text-xs text-slate-500 mt-1">Prueba con otro término de búsqueda o cambia el filtro seleccionado.</p>
    </div>

  </div>

  <script>
    let activeFilter = 'all';
    const filterButtons = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const bookWrappers = document.querySelectorAll('.book-wrapper') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('emptyState');

    function applyFilterAndSearch() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      bookWrappers.forEach((el) => {
        const status = el.dataset.status;
        const rating = Number(el.dataset.rating || 0);
        const title = el.dataset.title || '';
        const author = el.dataset.author || '';

        // Check filter
        let matchesFilter = true;
        if (activeFilter === 'read') matchesFilter = status === 'read';
        else if (activeFilter === 'currently-reading') matchesFilter = status === 'currently-reading';
        else if (activeFilter === 'did-not-finish') matchesFilter = status === 'did-not-finish';
        else if (activeFilter === 'top') matchesFilter = rating === 5;

        // Check search
        const matchesSearch = !query || title.includes(query) || author.includes(query);

        if (matchesFilter && matchesSearch) {
          el.style.display = '';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('active', 'bg-white', 'shadow-xs', 'text-slate-900');
          b.classList.add('text-slate-600');
        });

        btn.classList.add('active', 'bg-white', 'shadow-xs', 'text-slate-900');
        btn.classList.remove('text-slate-600');
        activeFilter = (btn as HTMLElement).dataset.filter || 'all';
        applyFilterAndSearch();
      });
    });

    searchInput?.addEventListener('input', applyFilterAndSearch);
  </script>
</BaseLayout>
