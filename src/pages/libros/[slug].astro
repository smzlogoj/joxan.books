---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingStars from '../../components/RatingStars.astro';
import BookStatusBadge from '../../components/BookStatusBadge.astro';

export async function getStaticPaths() {
  const books = (await getCollection('books')).filter(b => b.data.published !== false);
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);

const isbn = book.data.isbn13 || book.data.isbn;
const coverUrl = isbn 
  ? `https://covers.openlibrary.org/b/isbn/${isbn}-L.jpg?default=false` 
  : null;
---

<BaseLayout 
  title={`${book.data.title} · Reseña de ${book.data.author} | joxan.books`}
  description={`Reseña literaria y análisis de ${book.data.title} por ${book.data.author}.`}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    
    <!-- Breadcrumb & Actions Bar -->
    <div class="flex items-center justify-between gap-4 mb-8 text-xs">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-slate-500 hover:text-blue-600 font-semibold transition-colors group"
      >
        <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Volver a la estantería</span>
      </a>

      <a 
        href={`/admin/#/collections/books/entries/${book.id}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition-colors"
        title="Editar esta reseña en el CMS"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
        <span>Editar reseña</span>
      </a>
    </div>

    <!-- Book Hero / Technical Specs -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/90 shadow-sm mb-10">
      <div class="flex flex-col sm:flex-row gap-6 sm:gap-8 items-start">
        
        <!-- Large Cover -->
        <div class="w-full sm:w-48 aspect-[2/3] shrink-0 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 shadow-md relative flex items-center justify-center">
          {coverUrl ? (
            <img 
              src={coverUrl} 
              alt={`Portada de ${book.data.title}`} 
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
          ) : null}

          <div 
            class="w-full h-full p-4 flex flex-col justify-center items-center text-center bg-gradient-to-br from-slate-800 to-slate-950 text-white"
            style={coverUrl ? "display: none;" : "display: flex;"}
          >
            <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold mb-2">Libro</span>
            <h4 class="font-bold text-sm leading-snug line-clamp-3 mb-1 text-slate-100">{book.data.title}</h4>
            <p class="text-[11px] text-slate-300 line-clamp-1">{book.data.author}</p>
          </div>
        </div>

        <!-- Info details -->
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3">
            <BookStatusBadge status={book.data.status} />
            {book.data.aiGenerated && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
                🤖 Reseña generada por IA
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight mb-1">
            {book.data.title}
          </h1>
          <p class="text-base sm:text-lg text-slate-600 font-medium mb-4">
            Por <strong class="text-slate-900 font-semibold">{book.data.author}</strong>
          </p>

          <div class="mb-6 flex items-center gap-3">
            <RatingStars rating={book.data.rating} showText={true} />
            {book.data.rating > 0 && (
              <span class="text-xs text-slate-400">· Valoración en Goodreads</span>
            )}
          </div>

          <!-- Technical Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-slate-100 text-xs">
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Editorial</span>
              <strong class="text-slate-800 font-semibold">{book.data.publisher || 'N/A'}</strong>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Páginas</span>
              <strong class="text-slate-800 font-semibold">{book.data.pages ? `${book.data.pages} págs` : 'N/A'}</strong>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Año publicación</span>
              <strong class="text-slate-800 font-semibold">{book.data.year || 'N/A'}</strong>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Fecha lectura</span>
              <strong class="text-slate-800 font-semibold">{book.data.dateRead || (book.data.status === 'currently-reading' ? 'En curso' : 'N/A')}</strong>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Favorite Quote -->
    {book.data.favoriteQuote && (
      <div class="mb-10 p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm border-l-4 border-l-blue-600">
        <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 block mb-2">Cita o pasaje destacado</span>
        <blockquote class="text-base sm:text-lg italic text-slate-800 leading-relaxed">
          "{book.data.favoriteQuote}"
        </blockquote>
      </div>
    )}

    <!-- Review Prose Body -->
    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/90 shadow-sm">
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900 tracking-tight">Crítica & Análisis Literario</h2>
        <span class="text-[11px] font-medium text-slate-400">Lectura reflexiva</span>
      </div>

      <div class="space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base prose prose-slate max-w-none prose-headings:text-slate-900 prose-headings:font-bold prose-a:text-blue-600 prose-strong:text-slate-900 prose-blockquote:border-l-blue-600 prose-blockquote:bg-slate-50 prose-blockquote:p-4 prose-blockquote:rounded-r-lg">
        <Content />
      </div>
    </div>

    <!-- Bottom Navigation -->
    <div class="mt-12 text-center">
      <a 
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-blue-600 text-white text-xs font-semibold shadow-sm transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Volver al catálogo completo</span>
      </a>
    </div>

  </article>
</BaseLayout>
